mu = 0.02
get_median <- function(n){
inside = qchisq(0.5, 1, ncp =n*mu^2)
median = 1 - pchisq(inside, 1)
return(median)
}
n_values <- unique(round(10^seq(log10(2), 6, length.out = 1000)))
median_values <- get_median(n_values)
plot(n_values, median_values,
type = "l", log = "x",
col = "blue", lwd = 2,
xlab = "Sample size n",
ylab = "Median p-value",
main = "Median p-value versus sample size",
ylim = c(0, 1))
mu = 0.02
get_q90 <- function(n){
inside = qchisq(0.1, 1, ncp =n*mu^2)
median = 1 - pchisq(inside, 1)
return(median)
}
