<?xml version='1.0' encoding='utf-8'?>
<beast version="2.7" required="BEAST.base v2.7.8" namespace="beast.base.core:beast.base.inference:beast.base.inference.parameter:beast.base.evolution.alignment:beast.base.evolution.tree:beast.base.evolution.tree.coalescent:beast.base.evolution.substitutionmodel:beast.base.evolution.sitemodel:beast.base.evolution.likelihood:beast.base.evolution.branchratemodel:beast.base.evolution.operator">
    <data id="sequences" spec="Alignment" name="alignment">
        <sequence id="seq_t1" spec="Sequence" taxon="t1" totalcount="4" value="" />
        <sequence id="seq_t2" spec="Sequence" taxon="t2" totalcount="4" value="" />
        <sequence id="seq_t3" spec="Sequence" taxon="t3" totalcount="4" value="" />
        <sequence id="seq_t4" spec="Sequence" taxon="t4" totalcount="4" value="" />
        <sequence id="seq_t5" spec="Sequence" taxon="t5" totalcount="4" value="" />
        <sequence id="seq_t6" spec="Sequence" taxon="t6" totalcount="4" value="" />
    </data>
    <!--Matched to VB_master_A.R experiment 20261025_221200: fixed coalescent times, HKY kappa=2, equal base frequencies, strict clock rate=0.01, and topology moves only.-->
    <!--Start at the saved estimated_tree; start choice affects initialization, not the target distribution.-->
    <run id="mcmc" spec="MCMC" chainLength="10000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="tree" spec="TreeParser" name="stateNode" taxa="@sequences" newick="(t4:6.41912658,(t6:4.943718302,(t5:4.848589576,(t1:4.38592953,(t2:2.654841286,t3:2.654841286):1.731088244):0.4626600462):0.09512872616):1.475408278);" />
        </state>
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="coalescent" spec="Coalescent">
                    <treeIntervals id="treeIntervals" spec="beast.base.evolution.tree.TreeIntervals" tree="@tree" />
                    <populationModel id="popModel" spec="ConstantPopulation">
                        <parameter id="popSize" spec="parameter.RealParameter" estimate="false" name="popSize">1.0</parameter>
                    </populationModel>
                </distribution>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution">
                <distribution id="treeLikelihood.sequences" spec="TreeLikelihood" data="@sequences" tree="@tree">
                    <siteModel id="siteModel" spec="SiteModel" gammaCategoryCount="1">
                        <parameter id="mutationRate" spec="parameter.RealParameter" estimate="false" name="mutationRate">1.0</parameter>
                        <parameter id="proportionInvariant" spec="parameter.RealParameter" estimate="false" name="proportionInvariant">0.0</parameter>
                        <substModel id="hky" spec="HKY">
                            <parameter id="kappa" spec="parameter.RealParameter" estimate="false" name="kappa">2.0</parameter>
                            <frequencies id="freqs" spec="Frequencies">
                                <parameter id="freqParameter" spec="parameter.RealParameter" estimate="false" name="frequencies" dimension="4">0.25 0.25 0.25 0.25</parameter>
                            </frequencies>
                        </substModel>
                    </siteModel>
                    <branchRateModel id="strictClock" spec="beast.base.evolution.branchratemodel.StrictClockModel">
                        <parameter id="clockRate" spec="parameter.RealParameter" estimate="false" name="clock.rate">0.01</parameter>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="narrowExchange" spec="Exchange" isNarrow="true" tree="@tree" weight="15.0" />
        <operator id="wideExchange" spec="Exchange" isNarrow="false" tree="@tree" weight="3.0" />
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="1000" model="@posterior">
            <log idref="posterior" />
            <log idref="likelihood" />
            <log idref="prior" />
            <log idref="treeLikelihood.sequences" />
            <log idref="coalescent" />
            <log id="treeHeight" spec="beast.base.evolution.tree.TreeStatLogger" tree="@tree" />
        </logger>
        <logger id="screenlog" spec="Logger" logEvery="1000">
            <log idref="posterior" />
            <log idref="treeLikelihood.sequences" />
        </logger>
        <logger id="treelog" spec="Logger" fileName="$(filebase)-$(tree).trees" logEvery="1000" mode="tree">
            <log id="treeLogger" spec="beast.base.evolution.TreeWithMetaDataLogger" tree="@tree" />
        </logger>
    </run>
</beast>